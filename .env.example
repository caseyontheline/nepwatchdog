# Copy to .env and adjust. On the Pi, set HW_MODE=real.

# mock (default, safe anywhere) | real (Pi talking to the LOGO! + weather)
HW_MODE=mock

# --- Siemens LOGO! 8.3 (Modbus TCP) — single control point ---
LOGO_HOST=192.168.1.10
LOGO_PORT=502
LOGO_UNIT_ID=1

# --- Temperature zones (read from LOGO! holding registers) ---
# reg = Modbus holding-register (VW) address; temp_f = raw*scale + offset.
# Tune scale/offset to your LOGO! program's analog handling.
CTRL1_NAME=Heater Zone 1
CTRL1_REG=0
CTRL1_SCALE=1.0
CTRL1_OFFSET=0.0
CTRL2_NAME=Heater Zone 2
CTRL2_REG=1
CTRL2_SCALE=1.0
CTRL2_OFFSET=0.0
SETPOINT_F=400
POLL_INTERVAL_SEC=2
TEMP_WARN_F=375
TEMP_CRIT_F=425

# --- Reset (commanded via the LOGO!, which pulses the Phoenix Contact relay) ---
RESET_COIL=0            # Modbus coil address of the LOGO! reset marker
RESET_HOLD_SEC=1.0
RESET_COOLDOWN_SEC=10

# --- Weather (Ambient Weather WS-2902) — informational only, does not gate reset ---
WEATHER_ENABLED=true
AMBIENT_API_KEY=        # from ambientweather.net account (leave blank = mock)
AMBIENT_APP_KEY=

# --- History storage (SQLite) ---
DB_PATH=data/watchdog.db
HISTORY_RETENTION_DAYS=30

# --- Alerting (email via Resend, optional; blank = log-only) ---
RESEND_API_KEY=
ALERT_EMAIL_FROM=watchdog@heater.local
ALERT_EMAIL_TO=            # comma-separated recipients
ALERT_EMAIL_MIN_SEVERITY=warning   # warning | critical

# --- Cameras (3x Hikvision -> MediaMTX WebRTC) ---
MEDIAMTX_BASE=http://localhost:8889
CAM1_NAME=Burner
CAM1_PATH=cam1
CAM2_NAME=Tank
CAM2_PATH=cam2
CAM3_NAME=Belt
CAM3_PATH=cam3
# RTSP substream URLs used by the YOLO detector (lower res = lighter on the Pi).
# Hikvision substream: rtsp://USER:PASS@CAM_IP:554/Streaming/Channels/102
CAM1_RTSP=
CAM2_RTSP=
CAM3_RTSP=

# --- YOLO vision (Pi 5) ---
VISION_ENABLED=true
VISION_MODEL=yolov8n.pt
VISION_FPS=2
VISION_CONF=0.4
VISION_ALERT_CLASSES=person   # comma-separated COCO classes that raise an alert
VISION_ALERT_COOLDOWN_SEC=30
VISION_BROADCAST_SEC=0.5
